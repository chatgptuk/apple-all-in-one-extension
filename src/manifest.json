{
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "manifest_version": 3,
  "key": "",
  "background": {
    "service_worker": "background-bootstrap.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon-32.png",
    "default_title": "__MSG_extensionName__"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/*"
      ],
      "js": [
        "passwordsContent.bundle.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "*://*/*"
      ],
      "js": [
        "passkeyBridge.bundle.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://*/*"
      ],
      "js": [
        "passkeyGuard.bundle.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "contentScript.bundle.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "options_page": "options.html",
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "icloud_com_simulation_headers",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "alarms",
    "privacy",
    "declarativeNetRequest",
    "storage",
    "tabs",
    "scripting",
    "contextMenus",
    "webRequest",
    "notifications",
    "favicon"
  ],
  "host_permissions": [
    "*://*/*",
    "https://*.icloud.com/*",
    "https://*.icloud.com.cn/*"
  ],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/inline.html",
        "src/inline.css",
        "src/inline.js"
      ],
      "matches": [
        "*://*/*"
      ]
    }
  ],
  "version": "1.2.20",
  "default_locale": "en"
}
